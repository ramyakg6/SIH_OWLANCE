# OwLance Backend Environment Configuration
PROJECT_NAME="OwLance Backend"
VERSION="0.1.0"

# Database. SQLite by default so a fresh clone runs with zero setup.
# Uncomment the PostgreSQL line to use Postgres instead; if that server is
# unreachable the backend falls back to SQLite rather than failing to boot.
DATABASE_URL="sqlite:///./owlance.db"
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/owlance"
SQLITE_FALLBACK_URL="sqlite:///./owlance.db"

# --- Authentication ---
# SECRET_KEY signs session tokens. Leave it unset for local development and a
# fresh random key is generated on each boot (which invalidates sessions on
# restart). Set a fixed value for anything deployed.
# SECRET_KEY="change-me-to-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# A demo account is seeded on first boot so a fresh clone is reachable.
# Set SEED_DEMO_USER=false before exposing the service publicly.
SEED_DEMO_USER=true
DEMO_EMAIL="demo@owlance.in"
DEMO_PASSWORD="owlance2026"

# Cache TTL & Timeouts
CACHE_TTL_HOURS=24
REQUEST_TIMEOUT=10.0

# Scan bounds. crt.sh can return hundreds of hostnames for a real domain, so
# targets are prioritised, capped, resolved in parallel, and held to a
# wall-clock deadline. The scan endpoint always returns.
MAX_SCAN_TARGETS=25
DNS_WORKERS=12
DNS_TIMEOUT=2.0
DNS_LIFETIME=4.0
SCAN_DEADLINE_SECONDS=45.0

# --- WhatsApp delivery (Twilio) ---
#
# >>> THIS IS WHERE YOUR TWILIO CREDENTIALS GO. <<<
# Copy this file to `.env` (which is gitignored) and fill in the values.
# NEVER put real credentials in this example file: it is committed.
# Leave them blank and nothing breaks: /whatsapp/send-passport still composes
# the real message and returns it as a preview marked delivered=false.
#
# 1. TWILIO_ACCOUNT_SID   - Twilio Console home page, starts with "AC".
# 2. TWILIO_AUTH_TOKEN    - same page, next to the SID. Secret.
# 3. TWILIO_WHATSAPP_FROM - the SENDER, in E.164, no "whatsapp:" prefix.
#      This is the WhatsApp number TWILIO gives you (sandbox: +14155238886),
#      shown under Messaging > Try it out > Send a WhatsApp message.
#      It is NOT your own phone. Your own phone is the *recipient*.
#
# Trial accounts can only message VERIFIED recipients, and each recipient must
# first WhatsApp the "join <code>" phrase (shown on that same Console page)
# to the sender number.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="+14155238886"

# OPTIONAL - template mode. Leave blank to send the full free-text passport.
# Needed when Twilio answers "ContentSid Required" / error 63016 (trial
# accounts, or a recipient who has not messaged you in the last 24 hours).
# Use the template's HX... SID from Messaging > Content Template Builder.
TWILIO_CONTENT_SID=""
# Maps the template's {{1}}, {{2}}, ... to text. Tokens available: {domain},
# {score}, {band}, {confidence}, {as_of}, {passport_url}. Match your template.
TWILIO_CONTENT_VARIABLES='{"1": "{domain}", "2": "{score}/900 ({band})", "3": "{passport_url}"}'

# Applied to a number typed without a country code (e.g. "9876543210").
DEFAULT_PHONE_COUNTRY_CODE="+91"

# Base URL for the passport link inside the message.
PASSPORT_BASE_URL="https://owlance.in/p"

# External Threat Intel Endpoints
CRT_SH_URL="https://crt.sh"
EPSS_API_URL="https://api.first.org/data/v1/epss"
NVD_API_URL="https://services.nvd.nist.gov/rest/json/cves/2.0"
OSV_API_URL="https://api.osv.dev/v1/vulns"
CISA_KEV_URL="https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"

# Gemini Studio configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
